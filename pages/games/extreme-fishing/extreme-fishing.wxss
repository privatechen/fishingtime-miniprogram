.page {
  padding: 24rpx 20rpx;
  background: #f0f2f5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  max-width: 600rpx;
  margin: 60rpx auto 0;
  text-align: center;
}

/* 规则页 */
.intro-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.rule-item {
  font-size: 28rpx;
  color: #4e5969;
  margin-bottom: 16rpx;
  line-height: 1.6;
  text-align: left;
}
.intro-best {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2d8cf0;
}
.btn-start {
  margin-top: 32rpx;
  background: #2d8cf0;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
}
.btn-start::after {
  border: none;
}
.btn-rank {
  margin-top: 16rpx;
  width: 100%;
  padding: 12rpx;
  background: #2d8cf0;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
}
.btn-rank::after {
  border: none;
}

/* 游戏中 */
.play-area {
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
}
.play-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.top-btn {
  font-size: 28rpx;
  color: #2d8cf0;
  padding: 8rpx 0;
}
.game-name {
  font-size: 32rpx;
  font-weight: 700;
}
.top-placeholder {
  width: 100rpx;
}

/* HUD：左得分 / 中大倒计时 / 右河豚失误 */
.hud {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.hud-item {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #86909c;
}
.hud-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
}
.hud-danger {
  color: #e74c3c;
}
.timer-big {
  flex: 1;
  text-align: center;
  font-size: 56rpx;
  font-weight: 800;
  color: #1d2129;
  line-height: 1.2;
}
.timer-hurry {
  color: #e74c3c;
}

/* 棋盘：padding-bottom 撑高正方形，5×5 grid */
.board-wrap {
  position: relative;
  width: 100%;
}
.board-frame {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
}
.fish-board {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  display: grid;
  grid-template-rows: repeat(5, 1fr);
  gap: 6rpx;
  padding: 6rpx;
  box-sizing: border-box;
  border: 2rpx solid #bcd8f7;
  border-radius: 16rpx;
  background: #eef6ff;
}
.cell {
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cell.selected {
  background: rgba(45, 140, 240, 0.22);
}
.obj {
  width: 78%;
  height: 78%;
}

/* 撒网反馈 */
.net-feedback {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  font-weight: 800;
  padding: 8rpx 32rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  pointer-events: none;
  z-index: 10;
  white-space: nowrap;
}
.fb-ok {
  color: #2d8cf0;
}
.fb-perfect {
  color: #f39c12;
}
.fb-bad {
  color: #e74c3c;
}

.play-hint {
  text-align: center;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #86909c;
}

/* 结果页 */
.result-card {
  margin-top: 40rpx;
}
.result-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1d2129;
}
.result-fail {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #e74c3c;
}
.result-score {
  font-size: 80rpx;
  font-weight: 800;
  color: #2d8cf0;
  margin: 16rpx 0 24rpx;
}
.result-unit {
  font-size: 28rpx;
  font-weight: 600;
}
.result-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.result-item {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
}
.result-item text:first-child {
  display: block;
  font-size: 22rpx;
  color: #86909c;
  margin-bottom: 6rpx;
}
.result-item text:last-child {
  font-size: 30rpx;
  font-weight: 600;
}
.result-new {
  color: #27ae60;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.result-best {
  font-size: 26rpx;
  color: #86909c;
  margin-bottom: 20rpx;
}
.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.result-btn {
  flex: 1 1 45%;
  font-size: 28rpx;
  border-radius: 40rpx;
  line-height: 1.6;
}
.result-btn::after {
  border: none;
}
.primary {
  background: #2d8cf0;
  color: #fff;
}
.secondary {
  background: #f2f3f5;
  color: #4e5969;
}

/* ── 排行榜弹层 ── */
.rank-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.rank-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.rank-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.rank-state {
  text-align: center;
  color: #c9cdd4;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.rank-list {
  flex: 1;
  min-height: 0;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.rank-no {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #86909c;
}
.rank-top {
  color: #2d8cf0;
  font-weight: 700;
}
.rank-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d8cf0;
}
.rank-close {
  margin-top: 20rpx;
  text-align: center;
  color: #86909c;
  font-size: 28rpx;
  padding: 16rpx;
}
