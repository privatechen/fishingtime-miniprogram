.page {
  padding: 24rpx;
  background: #faf6f0;
  min-height: 100vh;
}

.game-list {
  background: #fff;
  border-radius: 28rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.04);
}

.game-card {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.game-card:last-child {
  border-bottom: none;
}

.game-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
  line-height: 1;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.game-cover-img {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
}

.game-info {
  flex: 1;
}
.game-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #332d27;
}
.game-desc {
  font-size: 24rpx;
  color: #9a9188;
  margin-top: 6rpx;
}

.game-arrow {
  color: #ff7a45;
  font-size: 40rpx;
  line-height: 1;
}
