.page {
  padding: 24rpx 20rpx;
  background: #f0f2f5;
  min-height: 100vh;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  max-width: 600rpx;
  margin: 60rpx auto 0;
  text-align: center;
}

/* 规则页 */
.intro-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}
.rule-item {
  font-size: 28rpx;
  color: #4e5969;
  margin-bottom: 16rpx;
}
.rule-label {
  color: #2d8cf0;
  font-weight: 600;
  margin-right: 12rpx;
}
.intro-duration {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #86909c;
}
.intro-best {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2d8cf0;
}
.btn-start {
  margin-top: 32rpx;
  background: #2d8cf0;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
}
.btn-start::after {
  border: none;
}

/* 倒计时 */
.countdown-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
}
.countdown-num {
  font-size: 200rpx;
  font-weight: 800;
  color: #2d8cf0;
  line-height: 1;
}
.countdown-tip {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #86909c;
}

/* 游戏中 */
.play-area {
  max-width: 600rpx;
  margin: 0 auto;
}
.play-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}
.top-btn {
  font-size: 28rpx;
  color: #2d8cf0;
  padding: 8rpx 0;
}
.game-name {
  font-size: 32rpx;
  font-weight: 700;
}
.timer {
  font-size: 32rpx;
  font-weight: 700;
}
.timer-hurry {
  color: #e74c3c;
}

.rule-tag {
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #2d8cf0;
  margin-bottom: 24rpx;
}
.rule-pulse {
  animation: pulse 0.3s ease;
}
@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.1); }
  100% { transform: scale(1); }
}

/* 题目区：大箭头 + 方向文字，视觉中心 */
.question-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 240rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}
.question-arrow {
  font-size: 120rpx;
  font-weight: 800;
  line-height: 1.2;
  color: #1d2129;
}
.question-word {
  font-size: 44rpx;
  font-weight: 600;
  color: #4e5969;
  margin-top: 8rpx;
}

.streak-bar {
  height: 40rpx;
  text-align: center;
  margin-bottom: 8rpx;
}
.streak-tip {
  font-size: 26rpx;
  color: #2d8cf0;
}

/* 十字方向键操作区 */
.direction-pad {
  margin-top: 8rpx;
}
.pad-row {
  display: flex;
  justify-content: center;
}
.pad-cell {
  width: 148rpx;
  height: 148rpx;
}
.pad-btn {
  width: 148rpx;
  height: 148rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 4rpx solid #e5e6eb;
  border-radius: 16rpx;
  font-size: 60rpx;
  font-weight: 700;
  color: #1d2129;
}
.pad-btn:active {
  background: #f2f3f5;
}
.answer-ok {
  border-color: #2ecc71;
  background: #eafaf1;
}
.answer-bad {
  border-color: #e74c3c;
  background: #fdecea;
}
.pad-center {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  line-height: 1.4;
  color: #86909c;
}

/* 结果页 */
.result-card {
  margin-top: 60rpx;
}
.result-score {
  font-size: 96rpx;
  font-weight: 800;
  color: #2d8cf0;
  margin-bottom: 24rpx;
}
.result-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.result-item {
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx 8rpx;
}
.result-item text:first-child {
  display: block;
  font-size: 22rpx;
  color: #86909c;
  margin-bottom: 8rpx;
}
.result-item text:last-child {
  font-size: 32rpx;
  font-weight: 600;
}
.ok {
  color: #27ae60;
}
.bad {
  color: #e74c3c;
}
.result-best {
  font-size: 26rpx;
  color: #86909c;
  margin-bottom: 20rpx;
}
.result-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.result-btn {
  flex: 1 1 45%;
  font-size: 28rpx;
  border-radius: 40rpx;
  line-height: 1.6;
}
.result-btn::after {
  border: none;
}
.primary {
  background: #2d8cf0;
  color: #fff;
}
.secondary {
  background: #f2f3f5;
  color: #4e5969;
}

/* ── 排行榜弹层 ── */
.rank-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.rank-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.rank-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.rank-state {
  text-align: center;
  color: #c9cdd4;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.rank-list {
  flex: 1;
  min-height: 0;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.rank-no {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #86909c;
}
.rank-top {
  color: #2d8cf0;
  font-weight: 700;
}
.rank-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d8cf0;
}
.rank-close {
  margin-top: 20rpx;
  text-align: center;
  color: #86909c;
  font-size: 28rpx;
  padding: 16rpx;
}

.btn-rank {
  margin-top: 16rpx;
  width: 100%;
  padding: 12rpx;
  background: #2d8cf0;
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
}
.btn-rank::after {
  border: none;
}
