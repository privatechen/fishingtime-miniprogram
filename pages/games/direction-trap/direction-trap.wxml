<view class="page">
  <!-- 规则说明 -->
  <view wx:if="{{view === 'intro'}}" class="card intro-card">
    <view class="intro-title">方向陷阱</view>
    <view class="rule-item"><text class="rule-label">看箭头</text><text>忽略文字，只看箭头指向</text></view>
    <view class="rule-item"><text class="rule-label">看文字</text><text>忽略箭头，只看文字方向</text></view>
    <view class="intro-duration">挑战时间：30 秒</view>
    <view wx:if="{{localBest > 0}}" class="intro-best">历史最高分：{{localBest}}</view>
    <button class="btn-start" bindtap="startGame">开始挑战</button>
    <button class="btn-rank" bindtap="onOpenRanking">排行榜</button>
  </view>

  <!-- 3、2、1 倒计时 -->
  <view wx:elif="{{view === 'countdown'}}" class="countdown-view">
    <view class="countdown-num">{{countdown}}</view>
    <view class="countdown-tip">准备，按当前规则快速作答</view>
  </view>

  <!-- 游戏中 -->
  <view wx:elif="{{view === 'playing'}}" class="play-area">
    <view class="play-topbar">
      <view class="top-btn" bindtap="backToGames">← 返回</view>
      <view class="game-name">方向陷阱</view>
      <view class="timer {{remainingSeconds <= 5 && remainingSeconds > 0 ? 'timer-hurry' : ''}}">{{remainingSeconds}}s</view>
    </view>

    <view class="rule-tag {{rulePulse ? 'rule-pulse' : ''}}">{{ruleText}}</view>

    <view class="question-area">
      <block wx:if="{{question}}">
        <text class="question-arrow">{{arrowSymbol}}</text>
        <text class="question-word">“{{wordText}}”</text>
      </block>
    </view>

    <view class="streak-bar">
      <text wx:if="{{streak >= 2}}" class="streak-tip">连续正确 {{streak}}</text>
      <text wx:else></text>
    </view>

    <!-- 十字方向键操作区 -->
    <view class="direction-pad">
      <view class="pad-row">
        <view class="pad-cell"></view>
        <view
          class="pad-btn {{feedback && feedback.answer === '上' ? (feedback.correct ? 'answer-ok' : 'answer-bad') : ''}}"
          data-direction="上"
          bindtap="handleAnswer"
        >↑</view>
        <view class="pad-cell"></view>
      </view>
      <view class="pad-row">
        <view
          class="pad-btn {{feedback && feedback.answer === '左' ? (feedback.correct ? 'answer-ok' : 'answer-bad') : ''}}"
          data-direction="左"
          bindtap="handleAnswer"
        >←</view>
        <view class="pad-cell pad-center">得分<br/>{{score}}</view>
        <view
          class="pad-btn {{feedback && feedback.answer === '右' ? (feedback.correct ? 'answer-ok' : 'answer-bad') : ''}}"
          data-direction="右"
          bindtap="handleAnswer"
        >→</view>
      </view>
      <view class="pad-row">
        <view class="pad-cell"></view>
        <view
          class="pad-btn {{feedback && feedback.answer === '下' ? (feedback.correct ? 'answer-ok' : 'answer-bad') : ''}}"
          data-direction="下"
          bindtap="handleAnswer"
        >↓</view>
        <view class="pad-cell"></view>
      </view>
    </view>
  </view>

  <!-- 结果 -->
  <view wx:elif="{{view === 'result' && result}}" class="card result-card">
    <view class="result-score">{{result.score}}</view>
    <view class="result-grid">
      <view class="result-item"><text>答题</text><text>{{result.totalCount}}</text></view>
      <view class="result-item"><text>正确</text><text class="ok">{{result.correctCount}}</text></view>
      <view class="result-item"><text>错误</text><text class="bad">{{result.wrongCount}}</text></view>
      <view class="result-item"><text>正确率</text><text>{{accuracyText}}</text></view>
      <view class="result-item"><text>平均反应</text><text>{{reactionText}}</text></view>
      <view class="result-item"><text>最高连对</text><text>{{result.maxStreak}}</text></view>
    </view>
    <view wx:if="{{localBest > 0}}" class="result-best">本地最佳 {{localBest}}</view>
    <view class="result-actions">
      <button class="result-btn secondary" bindtap="backToGames">返回列表</button>
      <button class="result-btn secondary" bindtap="onOpenRanking">排行榜</button>
      <button class="result-btn primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onSaveScore">保存成绩</button>
      <button class="result-btn primary" bindtap="startGame">再来一局</button>
    </view>
  </view>

    <!-- 排行榜弹层（公共组件：今日/总 Tab + 我的排名） -->
  <leaderboard-sheet
    visible="{{showRanking}}"
    game-code="direction-trap"
    game-name="方向陷阱"
    score-type="number"
    bind:close="onCloseRanking"
  />

  <!-- 设置用户名弹层（首次保存成绩时） -->
  <username-dialog
    visible="{{showUsernameDialog}}"
    bind:confirmed="onUsernameConfirmed"
    bind:close="onUsernameClose"
  />
</view>
