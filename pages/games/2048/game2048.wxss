.page {
  padding: 24rpx 20rpx;
  background: #f0f2f5;
  min-height: 100vh;
  max-width: 700rpx;
  margin: 0 auto;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.top-btn {
  font-size: 28rpx;
  color: #2d8cf0;
  padding: 8rpx 0;
}
.game-name {
  font-size: 34rpx;
  font-weight: 700;
}
.top-placeholder {
  width: 100rpx;
}

/* 成绩区 */
.scores {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.score-box {
  flex: 1;
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  text-align: center;
}
.score-label {
  display: block;
  font-size: 22rpx;
  color: #86909c;
}
.score-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1d2129;
}

/* 棋盘：grid 只承载 16 个固定背景格（4×4 固定），tile 用绝对定位 + transform */
.board {
  position: relative;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(4, 1fr);
  aspect-ratio: 1;
  background: #bbada0;
  border-radius: 12rpx;
  overflow: hidden;
}
.cell {
  margin: 4rpx;
  background: rgba(238, 228, 218, 0.35);
}
.board-shake {
  animation: boardShake 0.2s ease;
}
@keyframes boardShake {
  0%,
  100% {
    transform: translateX(0);
  }
  25% {
    transform: translateX(-6rpx);
  }
  75% {
    transform: translateX(6rpx);
  }
}
.tile {
  position: absolute;
  left: 0;
  top: 0;
  width: 25%;
  height: 25%;
  transition: transform 0.12s ease;
}
.tile-inner {
  margin: 4rpx;
  height: calc(100% - 8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  font-weight: 700;
  font-size: 44rpx;
  color: #fff;
}
.tile-pop {
  animation: tilePop 0.2s ease;
}
@keyframes tilePop {
  from {
    transform: scale(0.6);
    opacity: 0.5;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}
.tile-2 {
  background: #eee4da;
  color: #776e65;
}
.tile-4 {
  background: #ede0c8;
  color: #776e65;
}
.tile-8 {
  background: #f2b179;
}
.tile-16 {
  background: #f59563;
}
.tile-32 {
  background: #f67c5f;
}
.tile-64 {
  background: #f65e3b;
}
.tile-128 {
  background: #edcf72;
  font-size: 36rpx;
}
.tile-256 {
  background: #edcc61;
  font-size: 36rpx;
}
.tile-512 {
  background: #edc850;
  font-size: 32rpx;
}
.tile-1024 {
  background: #edc53f;
  font-size: 28rpx;
}
.tile-2048 {
  background: #edc22e;
  font-size: 28rpx;
}

/* 操作区 */
.ops {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
}
.op-btn {
  flex: 1 1 45%;
  font-size: 28rpx;
  border-radius: 40rpx;
  background: #fff;
  color: #1d2129;
  line-height: 1.6;
}
.op-btn::after {
  border: none;
}

/* 弹窗 */
.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.dialog {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 580rpx;
  max-width: 85%;
  text-align: center;
}
.dialog-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}
.dialog-body {
  font-size: 28rpx;
  color: #4e5969;
  line-height: 1.6;
  margin-bottom: 24rpx;
}
.dialog-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.dialog-btn {
  flex: 1;
  font-size: 28rpx;
  border-radius: 40rpx;
  line-height: 1.6;
}
.dialog-btn::after {
  border: none;
}
.primary {
  background: #2d8cf0;
  color: #fff;
}
.secondary {
  background: #f2f3f5;
  color: #4e5969;
}

/* 结算 */
.result-dialog {
  width: 560rpx;
}
.result-item {
  font-size: 28rpx;
  color: #1d2129;
  margin-bottom: 12rpx;
}

/* 排行榜弹层 */
.rank-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}
.rank-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.rank-state {
  text-align: center;
  color: #c9cdd4;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.rank-list {
  flex: 1;
  min-height: 0;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.rank-no {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #86909c;
}
.rank-top {
  color: #2d8cf0;
  font-weight: 700;
}
.rank-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d8cf0;
}
.rank-close {
  margin-top: 20rpx;
  text-align: center;
  color: #86909c;
  font-size: 28rpx;
  padding: 16rpx;
}
