.page {
  padding: 20rpx;
  background: #f0f2f5;
  min-height: 100vh;
}

/* ── 身份区 ── */
.identity-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.identity-icon {
  font-size: 72rpx;
  line-height: 1;
}
.identity-body {
  flex: 1;
}
.identity-name {
  font-size: 34rpx;
  font-weight: 600;
}
.save-btn {
  background: #2d8cf0;
  color: #fff;
  font-size: 26rpx;
  border-radius: 32rpx;
  padding: 12rpx 28rpx;
  line-height: 1.6;
  flex-shrink: 0;
}
.save-btn::after {
  border: none;
}
.save-btn[disabled] {
  background: #b3d3f7;
  color: #fff;
}

/* ── 分区 ── */
.section {
  background: #fff;
  border-radius: 16rpx;
  margin-top: 20rpx;
  padding: 4rpx 24rpx 8rpx;
}
.section-title {
  font-size: 26rpx;
  color: #86909c;
  padding: 20rpx 0 8rpx;
}

/* ── 游戏卡片 ── */
.game-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 1rpx solid #f0f2f5;
}
.game-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  line-height: 1;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.game-icon-img {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
}
.game-icon-emoji {
  font-size: 48rpx;
  line-height: 1;
}
.game-info {
  flex: 1;
}
.game-name {
  font-size: 30rpx;
  font-weight: 600;
}
.game-primary {
  font-size: 26rpx;
  color: #1d2129;
  margin-top: 4rpx;
}
.game-secondary {
  font-size: 22rpx;
  color: #86909c;
  margin-top: 4rpx;
}
.game-arrow {
  color: #c9cdd4;
  font-size: 40rpx;
  line-height: 1;
}

/* ── 更多（view 与 button 样式完全统一） ── */
.more-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin: 0;
  padding: 28rpx 0;
  border-top: 1rpx solid #f0f2f5;
  border-radius: 0;
  font-size: 28rpx;
  line-height: 1.4;
  color: #1d2129;
  text-align: left;
  background: transparent;
}
.more-item::after {
  border: none;
}
.more-arrow {
  color: #c9cdd4;
  font-size: 36rpx;
  line-height: 1;
}

/* ── 反馈输入弹层 ── */
.feedback-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.feedback-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}
.feedback-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.feedback-textarea {
  width: 100%;
  height: 200rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.feedback-count {
  text-align: right;
  font-size: 22rpx;
  color: #c9cdd4;
  margin-top: 8rpx;
}
.feedback-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.feedback-btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 32rpx;
  font-size: 30rpx;
  background: #f2f3f5;
  color: #86909c;
  line-height: 1.4;
}
.feedback-btn::after {
  border: none;
}
.feedback-submit {
  background: #2d8cf0;
  color: #fff;
}


/* ── 修改用户名 ── */
.edit-username-btn {
  background: #f2f3f5;
  color: #2d8cf0;
  font-size: 24rpx;
  border-radius: 32rpx;
  padding: 10rpx 22rpx;
  line-height: 1.6;
  flex-shrink: 0;
}
.edit-username-btn::after {
  border: none;
}
.edit-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.edit-sheet {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  width: 560rpx;
  max-width: 85%;
  text-align: center;
}
.edit-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}
.edit-tip {
  font-size: 24rpx;
  color: #86909c;
  margin-bottom: 20rpx;
}
.edit-input {
  width: 100%;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0 20rpx;
  border: 1rpx solid #e5e6eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1d2129;
  text-align: left;
}
.edit-placeholder {
  color: #c9cdd4;
}
.edit-error {
  color: #e74c3c;
  font-size: 24rpx;
  margin-top: 12rpx;
}
.edit-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}
.edit-btn {
  flex: 1;
  padding: 18rpx 0;
  border-radius: 32rpx;
  font-size: 30rpx;
  line-height: 1.4;
}
.edit-btn::after {
  border: none;
}
.edit-cancel {
  background: #f2f3f5;
  color: #86909c;
}
.edit-submit {
  background: #2d8cf0;
  color: #fff;
}

/* ── 我的瞅瞅 ── */
.qa-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.qa-stats {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 0 20rpx;
}
.qa-stat {
  text-align: center;
  flex: 1;
}
.qa-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #ff7a45;
}
.qa-none {
  font-size: 30rpx;
  color: #ff7a45;
  line-height: 72rpx;
}
.qa-label {
  font-size: 24rpx;
  color: #9a9188;
  margin-top: 4rpx;
}
.qa-title {
  text-align: center;
  color: #ff7a45;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.qa-answers-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 4rpx 4rpx;
  border-top: 1rpx solid #f0f2f5;
  font-size: 28rpx;
  color: #332d27;
}
.qa-answers-entry .arrow {
  color: #c9cdd4;
  font-size: 32rpx;
}

/* ── 我的回答弹层 ── */
.qa-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}
.qa-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 72vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.qa-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.qa-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
}
.qa-sheet-close {
  font-size: 30rpx;
  color: #86909c;
  padding: 8rpx;
}
.qa-scroll {
  flex: 1;
  min-height: 0;
}
.qa-state {
  text-align: center;
  color: #9a9188;
  padding: 40rpx 0;
  font-size: 26rpx;
}
.qa-empty {
  text-align: center;
  color: #9a9188;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.qa-end {
  text-align: center;
  color: #c9cdd4;
  padding: 20rpx 0;
  font-size: 24rpx;
}
.qa-retry {
  margin-top: 16rpx;
  background: #ff7a45;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 40rpx;
}
.qa-retry::after {
  border: none;
}
.qa-item {
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.qa-item:last-child {
  border-bottom: none;
}
.qa-item-q {
  font-size: 30rpx;
  font-weight: 600;
  color: #332d27;
  margin-bottom: 8rpx;
}
.qa-item-mine {
  font-size: 26rpx;
  color: #6b635c;
  margin-bottom: 8rpx;
}
.qa-item-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.qa-item-rate {
  font-size: 24rpx;
  color: #ff7a45;
}
.qa-item-date {
  font-size: 24rpx;
  color: #9a9188;
}

/* ── 结果态详情 ── */
.qa-detail {
  padding: 8rpx 4rpx;
}
.qa-detail-cat {
  display: inline-block;
  background: #fff2e8;
  color: #ff7a45;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
}
.qa-detail-q {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #332d27;
  margin-bottom: 24rpx;
}
.qa-detail-option {
  background: #f7f3ee;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.qa-detail-option.mine {
  background: #fff2e8;
  border: 2rpx solid #ff7a45;
}
.qa-detail-opt-row {
  display: flex;
  align-items: center;
}
.qa-detail-opt-row .opt-icon {
  font-size: 30rpx;
  margin-right: 12rpx;
}
.qa-detail-opt-row .opt-text {
  flex: 1;
  font-size: 28rpx;
  color: #332d27;
}
.mine-tag {
  color: #ff7a45;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 10rpx;
}
.opt-percent {
  color: #ff7a45;
  font-weight: 700;
  font-size: 26rpx;
}
.bar-bg {
  margin-top: 12rpx;
  height: 12rpx;
  background: rgba(255, 122, 69, 0.12);
  border-radius: 8rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: #ff7a45;
  border-radius: 8rpx;
}
.qa-detail-tip {
  text-align: center;
  color: #9a9188;
  font-size: 24rpx;
  margin: 16rpx 0;
}
.qa-back-list {
  background: #ff7a45;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}
.qa-back-list::after {
  border: none;
}
