<view class="page">
  <!-- 身份区 -->
  <view class="identity-card">
    <view class="identity-icon">🐟</view>
    <view class="identity-body">
      <view class="identity-name">{{loggedIn ? nickname : '未登录'}}</view>
    </view>
    <button
      wx:if="{{!loggedIn}}"
      class="save-btn"
      loading="{{loggingIn}}"
      bindtap="onSaveRecord"
    >登录/注册</button>
    <button
      wx:elif="{{loggedIn}}"
      class="edit-username-btn"
      bindtap="onEditUsername"
    >修改用户名</button>
  </view>

  <!-- 我的瞅瞅 -->
  <view wx:if="{{loggedIn}}" class="section qa-card">
    <view class="section-title">我的瞅瞅</view>
    <view class="qa-stats">
      <view class="qa-stat">
        <view class="qa-num">{{qaStats.answerCount}}</view>
        <view class="qa-label">回答问题</view>
      </view>
      <view class="qa-stat">
        <view wx:if="{{qaStats.answerCount > 0}}" class="qa-num">{{qaStats.majorityRate}}%</view>
        <view wx:else class="qa-num qa-none">还没瞅过</view>
        <view class="qa-label">大众派</view>
      </view>
    </view>
    <view wx:if="{{qaStats.majorityTitle}}" class="qa-title">「{{qaStats.majorityTitle}}」</view>
    <view class="qa-answers-entry" bindtap="openQaAnswers">
      <text>我的回答</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <!-- 我的游戏 -->
  <view class="section">
    <view class="section-title">我的解压程度</view>
    <view wx:for="{{games}}" wx:key="id" class="game-item" data-id="{{item.id}}" bindtap="onGameTap">
      <view class="game-icon">
        <image wx:if="{{item.hasIcon}}" class="game-icon-img" src="{{item.icon}}" mode="aspectFill" />
        <text wx:else class="game-icon-emoji">{{item.icon}}</text>
      </view>
      <view class="game-info">
        <view class="game-name">{{item.name}}</view>
        <view class="game-primary">{{item.primaryLabel}} {{item.primaryValue}}</view>
        <view wx:if="{{item.secondaryValue}}" class="game-secondary">{{item.secondaryLabel}} {{item.secondaryValue}}</view>
      </view>
      <view class="game-arrow">›</view>
    </view>
  </view>

  <!-- 更多 -->
  <view class="section">
    <view class="more-item" bindtap="onFeedbackTap">
      <text>说你要啥</text><text class="more-arrow">›</text>
    </view>
    <view class="more-item" bindtap="onAbout">
      <text>关于摸鱼</text><text class="more-arrow">›</text>
    </view>
  </view>

  <!-- 反馈输入弹层 -->
  <view wx:if="{{showFeedback}}" class="feedback-mask" bindtap="onCloseFeedback">
    <view class="feedback-sheet" catchtap="noop">
      <view class="feedback-title">说你要啥</view>
      <textarea
        class="feedback-textarea"
        value="{{feedbackContent}}"
        placeholder="说说你的想法，或提点建议～"
        maxlength="200"
        bindinput="onFeedbackInput"
      ></textarea>
      <view class="feedback-count">{{feedbackContent.length}}/200</view>
      <view class="feedback-actions">
        <button class="feedback-btn" bindtap="onCloseFeedback">取消</button>
        <button class="feedback-btn feedback-submit" loading="{{feedbackSubmitting}}" bindtap="onSubmitFeedback">提交</button>
      </view>
    </view>
  </view>

  <!-- 设置用户名弹层（登录/注册时） -->
  <username-dialog
    visible="{{showUsernameDialog}}"
    bind:confirmed="onUsernameConfirmed"
    bind:close="onUsernameClose"
  />

  <!-- 修改用户名弹层 -->
  <view wx:if="{{showUsernameEdit}}" class="edit-mask" bindtap="onEditUsernameClose">
    <view class="edit-sheet" catchtap="noop">
      <view class="edit-title">修改用户名</view>
      <view class="edit-tip">修改后昵称将同步为新用户名</view>
      <input
        class="edit-input"
        value="{{editUsername}}"
        maxlength="32"
        placeholder="请输入新用户名（3~32 个字符）"
        placeholder-class="edit-placeholder"
        bindinput="onEditUsernameInput"
      />
      <view wx:if="{{editError}}" class="edit-error">{{editError}}</view>
      <view class="edit-actions">
        <button class="edit-btn edit-cancel" bindtap="onEditUsernameClose">取消</button>
        <button class="edit-btn edit-submit" loading="{{editSubmitting}}" disabled="{{editSubmitting}}" bindtap="onEditUsernameSubmit">确认</button>
      </view>
    </view>
  </view>

  <!-- 我的回答弹层 -->
  <view wx:if="{{showQaAnswers}}" class="qa-mask" bindtap="closeQaAnswers">
    <view class="qa-sheet" catchtap="noop">
      <view class="qa-sheet-head">
        <view class="qa-sheet-title">我的回答</view>
        <view class="qa-sheet-close" bindtap="closeQaAnswers">✕</view>
      </view>

      <!-- 历史列表 -->
      <block wx:if="{{!qaDetail}}">
        <view wx:if="{{qaError}}" class="qa-state">
          <view>{{qaError}}</view>
          <button class="qa-retry" bindtap="onQaRetry">重试</button>
        </view>
        <scroll-view wx:else scroll-y class="qa-scroll" bindscrolltolower="onQaScrollBottom">
          <view wx:if="{{qaList.length === 0 && !qaLoading}}" class="qa-empty">还没留下选择，去瞅瞅大家怎么选吧</view>
          <view
            wx:for="{{qaList}}"
            wx:key="questionId"
            class="qa-item"
            data-qid="{{item.questionId}}"
            bindtap="onQaItemTap"
          >
            <view class="qa-item-q">{{item.question}}</view>
            <view class="qa-item-mine">你选：{{item.myAnswer}}</view>
            <view class="qa-item-foot">
              <text wx:if="{{item.sameRate != null}}" class="qa-item-rate">{{item.sameRate}}% 的人和你一样</text>
              <text wx:else class="qa-item-rate">题目已下线</text>
              <text class="qa-item-date">{{item.answeredDate}}</text>
            </view>
          </view>
          <view wx:if="{{qaLoading}}" class="qa-state">加载中...</view>
          <view wx:if="{{!qaHasMore && qaList.length > 0}}" class="qa-end">没有更多了</view>
        </scroll-view>
      </block>

      <!-- 结果态详情 -->
      <block wx:else>
        <scroll-view scroll-y class="qa-scroll">
          <view wx:if="{{qaDetail}}" class="qa-detail">
            <view class="qa-detail-cat">{{qaDetail.categoryName}}</view>
            <view class="qa-detail-q">{{qaDetail.content}}</view>
            <view
              wx:for="{{qaDetail.options}}"
              wx:key="id"
              class="qa-detail-option {{item.id === qaDetail.myOptionId ? 'mine' : ''}}"
            >
              <view class="qa-detail-opt-row">
                <text class="opt-icon">{{item.icon}}</text>
                <text class="opt-text">{{item.content}}</text>
                <text wx:if="{{item.id === qaDetail.myOptionId}}" class="mine-tag">✓ 你</text>
                <text class="opt-percent">{{item.percentText}}</text>
              </view>
              <view class="bar-bg"><view class="bar" style="width: {{item.percent}}%;"></view></view>
            </view>
            <view class="qa-detail-tip">该题已作答，不能再次投票</view>
            <button class="qa-back-list" bindtap="onQaDetailBack">返回列表</button>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>
</view>
