.page {
  min-height: 100vh;
  background: #faf6f0;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 分类栏 ── */
.cat-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #faf6f0;
  padding: 20rpx 0 16rpx;
  white-space: nowrap;
}
.cat-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 14rpx;
}
.cat-item {
  padding: 12rpx 28rpx;
  border-radius: 34rpx;
  background: #fff;
  color: #6b635c;
  font-size: 27rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.cat-item.active {
  background: #ff7a45;
  color: #fff;
  font-weight: 600;
}

/* ── 状态区 ── */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #9a9188;
  font-size: 28rpx;
}
.state-text {
  margin-bottom: 20rpx;
  text-align: center;
}
.finished-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.retry-btn {
  background: #ff7a45;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
}
.retry-btn::after {
  border: none;
}

/* ── 题目卡 ── */
.question-card {
  margin: 8rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  padding: 40rpx 32rpx;
}
.q-cat {
  display: inline-block;
  background: #fff2e8;
  color: #ff7a45;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.q-content {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #332d27;
  margin-bottom: 32rpx;
}

/* ── 选项 ── */
.option {
  display: flex;
  align-items: center;
  background: #f7f3ee;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  color: #332d27;
}
.option.disabled {
  opacity: 0.6;
}
.option.selected {
  background: #fff2e8;
  border-color: #ff7a45;
}
.opt-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
}
.opt-text {
  flex: 1;
}
.answer-count {
  text-align: center;
  color: #9a9188;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* ── 结果态 ── */
.option.result {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 24rpx;
}
.opt-row {
  display: flex;
  align-items: center;
}
.option.result.mine {
  background: #fff2e8;
  border: 2rpx solid #ff7a45;
}
.mine-tag {
  color: #ff7a45;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 12rpx;
}
.opt-percent {
  color: #ff7a45;
  font-weight: 700;
  font-size: 28rpx;
}
.bar-bg {
  margin-top: 14rpx;
  height: 14rpx;
  background: rgba(255, 122, 69, 0.12);
  border-radius: 10rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: #ff7a45;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}
.feedback {
  text-align: center;
  color: #ff7a45;
  font-size: 26rpx;
  margin: 20rpx 0;
}
.next-btn,
.confirm-btn {
  background: #ff7a45;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.next-btn::after,
.confirm-btn::after {
  border: none;
}
.confirm-btn {
  margin-top: 24rpx;
}

/* ── 答完状态按钮 ── */
.retry-btn.ghost {
  margin-top: 16rpx;
  background: #fff;
  color: #ff7a45;
  border: 2rpx solid #ff7a45;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 1;
  padding: 0 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.retry-btn.ghost::after {
  border: none;
}
.submit-link {
  margin-top: 24rpx;
  background: none;
  border: none;
  color: #ff7a45;
  font-size: 26rpx;
  line-height: 1.4;
}
.submit-link::after {
  border: none;
}

/* ── 出题投稿弹层 ── */
.submit-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 1000;
}
.submit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  height: 78vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.submit-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.submit-title {
  font-size: 32rpx;
  font-weight: 700;
}
.submit-close {
  font-size: 30rpx;
  color: #86909c;
  padding: 8rpx;
}
.submit-scroll {
  flex: 1;
  min-height: 0;
}
.submit-field {
  margin-bottom: 24rpx;
}
.submit-label {
  font-size: 24rpx;
  color: #9a9188;
  margin-bottom: 12rpx;
  display: block;
}
.submit-cats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.submit-cat {
  padding: 10rpx 26rpx;
  border-radius: 30rpx;
  background: #f7f3ee;
  color: #6b635c;
  font-size: 26rpx;
}
.submit-cat.active {
  background: #ff7a45;
  color: #fff;
}
.submit-input {
  width: 100%;
  box-sizing: border-box;
  height: 120rpx;
  background: #f7f3ee;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.submit-opt-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.submit-opt-icon {
  width: 96rpx;
  height: 72rpx;
  background: #f7f3ee;
  border-radius: 12rpx;
  padding: 0 12rpx;
  font-size: 26rpx;
  text-align: center;
}
.submit-opt-content {
  flex: 1;
  height: 72rpx;
  background: #f7f3ee;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}
.submit-opt-del {
  color: #c9cdd4;
  font-size: 30rpx;
  padding: 8rpx;
}
.submit-opt-add {
  color: #ff7a45;
  font-size: 26rpx;
  padding: 8rpx 0;
}
.submit-error {
  color: #e74c3c;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}
.submit-tip {
  text-align: center;
  color: #9a9188;
  font-size: 22rpx;
  margin-top: 16rpx;
}

/* ── 我的投稿 ── */
.mine-item {
  padding: 22rpx 4rpx;
  border-bottom: 1rpx solid #f0f2f5;
}
.mine-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.mine-status {
  flex-shrink: 0;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
}
.mine-status.s0 { background: #fff2e8; color: #ff7a45; }
.mine-status.s1 { background: #eafaf1; color: #27ae60; }
.mine-status.s2 { background: #f2f3f5; color: #86909c; }
.mine-content {
  flex: 1;
  font-size: 28rpx;
  color: #332d27;
}
.mine-reason {
  font-size: 22rpx;
  color: #e74c3c;
  margin-top: 8rpx;
}
.mine-answered {
  font-size: 22rpx;
  color: #9a9188;
  margin-top: 8rpx;
}
.mine-detail {
  padding: 8rpx 4rpx;
}
.mine-detail-status {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 18rpx;
  margin-bottom: 16rpx;
}
.mine-detail-status.s0 { background: #fff2e8; color: #ff7a45; }
.mine-detail-status.s1 { background: #eafaf1; color: #27ae60; }
.mine-detail-status.s2 { background: #f2f3f5; color: #86909c; }
.mine-detail-q {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #332d27;
  margin-bottom: 24rpx;
}
.mine-answer-opt {
  background: #f7f3ee;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}
.mine-answer-opt.selected {
  background: #fff2e8;
  border-color: #ff7a45;
}
.mine-back {
  margin-top: 24rpx;
}

/* ── 结果态（我的投稿详情复用） ── */
.qa-detail-option {
  background: #f7f3ee;
  border-radius: 18rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}
.qa-detail-option.mine {
  background: #fff2e8;
  border: 2rpx solid #ff7a45;
}
.qa-detail-opt-row {
  display: flex;
  align-items: center;
}
.qa-detail-opt-row .opt-icon { font-size: 30rpx; margin-right: 12rpx; }
.qa-detail-opt-row .opt-text { flex: 1; font-size: 28rpx; color: #332d27; }
.qa-detail-opt-row .opt-percent { color: #ff7a45; font-weight: 700; font-size: 26rpx; }
.bar-bg {
  margin-top: 12rpx;
  height: 12rpx;
  background: rgba(255, 122, 69, 0.12);
  border-radius: 8rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: #ff7a45;
  border-radius: 8rpx;
}
.mine-tag {
  color: #ff7a45;
  font-size: 22rpx;
  font-weight: 700;
  margin-right: 10rpx;
}

/* ── 选项「设为我的答案」 ── */
.submit-opt-radio {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 3rpx solid #c9cdd4;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
}
.submit-opt-radio.on {
  background: #ff7a45;
  border-color: #ff7a45;
}
