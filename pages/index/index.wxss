.page {
  min-height: 100vh;
  background: #faf6f0;
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── 分类栏 ── */
.cat-bar {
  position: sticky;
  top: 0;
  z-index: 10;
  background: #faf6f0;
  padding: 20rpx 0 16rpx;
  white-space: nowrap;
}
.cat-list {
  display: inline-flex;
  padding: 0 24rpx;
  gap: 14rpx;
}
.cat-item {
  padding: 12rpx 28rpx;
  border-radius: 34rpx;
  background: #fff;
  color: #6b635c;
  font-size: 27rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.cat-item.active {
  background: #ff7a45;
  color: #fff;
  font-weight: 600;
}

/* ── 状态区 ── */
.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
  color: #9a9188;
  font-size: 28rpx;
}
.state-text {
  margin-bottom: 20rpx;
  text-align: center;
}
.finished-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.retry-btn {
  background: #ff7a45;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  height: 76rpx;
  line-height: 76rpx;
  padding: 0 48rpx;
}
.retry-btn::after {
  border: none;
}

/* ── 题目卡 ── */
.question-card {
  margin: 8rpx 24rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  padding: 40rpx 32rpx;
}
.q-cat {
  display: inline-block;
  background: #fff2e8;
  color: #ff7a45;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
}
.q-content {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #332d27;
  margin-bottom: 32rpx;
}

/* ── 选项 ── */
.option {
  display: flex;
  align-items: center;
  background: #f7f3ee;
  border-radius: 22rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 18rpx;
  font-size: 30rpx;
  color: #332d27;
}
.option.disabled {
  opacity: 0.6;
}
.opt-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
}
.opt-text {
  flex: 1;
}
.answer-count {
  text-align: center;
  color: #9a9188;
  font-size: 24rpx;
  margin-top: 12rpx;
}

/* ── 结果态 ── */
.option.result {
  flex-direction: column;
  align-items: stretch;
  padding: 20rpx 24rpx;
}
.opt-row {
  display: flex;
  align-items: center;
}
.option.result.mine {
  background: #fff2e8;
  border: 2rpx solid #ff7a45;
}
.mine-tag {
  color: #ff7a45;
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 12rpx;
}
.opt-percent {
  color: #ff7a45;
  font-weight: 700;
  font-size: 28rpx;
}
.bar-bg {
  margin-top: 14rpx;
  height: 14rpx;
  background: rgba(255, 122, 69, 0.12);
  border-radius: 10rpx;
  overflow: hidden;
}
.bar {
  height: 100%;
  background: #ff7a45;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}
.feedback {
  text-align: center;
  color: #ff7a45;
  font-size: 26rpx;
  margin: 20rpx 0;
}
.next-btn {
  background: #ff7a45;
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  height: 92rpx;
  line-height: 92rpx;
}
.next-btn::after {
  border: none;
}
