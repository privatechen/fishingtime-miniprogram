<view class="page">
  <!-- 分类栏 -->
  <scroll-view scroll-x class="cat-bar" enhanced show-scrollbar="{{false}}">
    <view class="cat-list">
      <view
        wx:for="{{categories}}"
        wx:key="code"
        class="cat-item {{activeCategoryCode === item.code ? 'active' : ''}}"
        data-code="{{item.code}}"
        bindtap="onCategoryTap"
      >{{item.icon}} {{item.name}}</view>
    </view>
  </scroll-view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state">加载中...</view>

  <!-- 加载失败 -->
  <view wx:elif="{{error}}" class="state">
    <view class="state-text">{{error}}</view>
    <button class="retry-btn" bindtap="loadNext">重试</button>
  </view>

  <!-- 分类答完 -->
  <view wx:elif="{{finished}}" class="state">
    <view class="finished-icon">🎉</view>
    <view class="state-text">这个分类暂时答完啦</view>
    <button class="retry-btn" bindtap="onSeeRecommend">看看推荐</button>
    <button class="retry-btn ghost" bindtap="onGoDecompress">去解压放松</button>
    <button class="submit-link" bindtap="openSubmit">想不出了？出个你自己的题 →</button>
    <button class="submit-link" bindtap="openMine">我的投稿</button>
  </view>

  <!-- 题目卡 -->
  <view wx:elif="{{question}}" class="question-card">
    <view class="q-cat">{{question.categoryName}}</view>
    <view class="q-content">{{question.content}}</view>

    <!-- 未答：选项按钮（答题前不展示比例） -->
    <block wx:if="{{!question.answered}}">
      <view
        wx:for="{{question.options}}"
        wx:key="id"
        class="option {{submitting ? 'disabled' : ''}}"
        data-oid="{{item.id}}"
        bindtap="onOptionTap"
      >
        <text class="opt-icon">{{item.icon}}</text>
        <text class="opt-text">{{item.content}}</text>
      </view>
      <view class="answer-count">已有 {{question.answerCountText}} 人回答</view>
    </block>

    <!-- 已答：结果态 -->
    <block wx:else>
      <view
        wx:for="{{question.options}}"
        wx:key="id"
        class="option result {{item.id === question.myOptionId ? 'mine' : ''}}"
      >
        <view class="opt-row">
          <text class="opt-icon">{{item.icon}}</text>
          <text class="opt-text">{{item.content}}</text>
          <text wx:if="{{item.id === question.myOptionId}}" class="mine-tag">✓ 你</text>
          <text class="opt-percent">{{item.percentText}}</text>
        </view>
        <view class="bar-bg"><view class="bar" style="width: {{item.percent}}%;"></view></view>
      </view>
      <view class="feedback">原来 {{myPercentText}}% 的人和你一样</view>
      <button class="next-btn" bindtap="onNext">下一题 →</button>
    </block>
  </view>

  <!-- 首次设置用户名弹层 -->
  <username-dialog
    visible="{{showUsernameDialog}}"
    bind:confirmed="onUsernameConfirmed"
    bind:close="onUsernameClose"
  />

  <!-- 出题投稿弹层 -->
  <view wx:if="{{showSubmit}}" class="submit-mask" bindtap="closeSubmit">
    <view class="submit-sheet" catchtap="noop">
      <view class="submit-head">
        <view class="submit-title">出题投稿</view>
        <view class="submit-close" bindtap="closeSubmit">✕</view>
      </view>
      <scroll-view scroll-y class="submit-scroll">
        <view class="submit-field">
          <text class="submit-label">分类</text>
          <view class="submit-cats">
            <view
              wx:for="{{realCategories}}"
              wx:key="code"
              class="submit-cat {{submitCategory === item.code ? 'active' : ''}}"
              data-code="{{item.code}}"
              bindtap="onPickCategory"
            >{{item.icon}} {{item.name}}</view>
          </view>
        </view>
        <view class="submit-field">
          <text class="submit-label">问题</text>
          <textarea
            class="submit-input"
            value="{{submitContent}}"
            placeholder="写一道轻松、无标准答案的问题"
            maxlength="100"
            bindinput="onSubmitContent"
          ></textarea>
        </view>
        <view class="submit-field">
          <text class="submit-label">选项（2~6 个）</text>
          <view wx:for="{{submitOptions}}" wx:key="index" class="submit-opt-row">
            <view
              class="submit-opt-radio {{submitAnswerIndex === index ? 'on' : ''}}"
              data-index="{{index}}"
              bindtap="onMarkAnswer"
            >{{submitAnswerIndex === index ? '✓' : ''}}</view>
            <input class="submit-opt-icon" value="{{item.icon}}" placeholder="图标" data-index="{{index}}" bindinput="onSubmitOptIcon" />
            <input class="submit-opt-content" value="{{item.content}}" placeholder="选项内容" data-index="{{index}}" bindinput="onSubmitOptContent" />
            <text class="submit-opt-del" data-index="{{index}}" bindtap="onRemoveOption">✕</text>
          </view>
          <view class="submit-opt-add" bindtap="onAddOption">＋ 添加选项</view>
          <view class="submit-tip">点选项左侧圆圈可设为「我的答案」（可选）</view>
        </view>
        <view wx:if="{{submitError}}" class="submit-error">{{submitError}}</view>
        <button class="retry-btn" loading="{{submitSubmitting}}" disabled="{{submitSubmitting}}" bindtap="onSubmitQuestion">提交审核</button>
        <view class="submit-tip">提交后需管理员审核，通过后就能让大家瞅瞅</view>
      </scroll-view>
    </view>
  </view>

  <!-- 我的投稿弹层 -->
  <view wx:if="{{showMine}}" class="submit-mask" bindtap="closeMine">
    <view class="submit-sheet" catchtap="noop">
      <view class="submit-head">
        <view class="submit-title">{{mineDetail ? '我的投稿' : '我的投稿'}}</view>
        <view class="submit-close" bindtap="closeMine">✕</view>
      </view>

      <!-- 列表 -->
      <block wx:if="{{!mineDetail}}">
        <scroll-view scroll-y class="submit-scroll">
          <view wx:if="{{mineList.length === 0}}" class="submit-tip" style="padding: 40rpx 0;">还没有投稿，答完去出个题吧</view>
          <view
            wx:for="{{mineList}}"
            wx:key="questionId"
            class="mine-item"
            data-index="{{index}}"
            bindtap="onMineItemTap"
          >
            <view class="mine-top">
              <text class="mine-status s{{item.status}}">{{item.status === 0 ? '待审核' : item.status === 1 ? '已上线' : '已驳回'}}</text>
              <text class="mine-content">{{item.content}}</text>
            </view>
            <view wx:if="{{item.rejectReason}}" class="mine-reason">驳回原因：{{item.rejectReason}}</view>
            <view wx:if="{{item.answered}}" class="mine-answered">已回答 ›</view>
          </view>
        </scroll-view>
      </block>

      <!-- 详情/回答 -->
      <block wx:else>
        <scroll-view scroll-y class="submit-scroll">
          <view wx:if="{{mineDetail}}" class="mine-detail">
            <view class="mine-detail-status s{{mineDetail.status}}">
              {{mineDetail.status === 0 ? '待审核' : mineDetail.status === 1 ? '已上线' : '已驳回'}}
            </view>
            <view wx:if="{{mineDetail.rejectReason}}" class="mine-reason">驳回原因：{{mineDetail.rejectReason}}</view>
            <view class="mine-detail-q">{{mineDetail.content}}</view>

            <!-- 待审且未答：可回答 -->
            <block wx:if="{{mineDetail.status === 0 && !mineDetail.answered}}">
              <view
                wx:for="{{mineDetail.options}}"
                wx:key="id"
                class="submit-opt-row mine-answer-opt"
                data-oid="{{item.id}}"
                bindtap="onMineOptionTap"
              >
                <text class="opt-icon">{{item.icon}}</text>
                <text class="opt-text">{{item.content}}</text>
              </view>
              <view class="submit-tip">选一个你的答案，通过后会算进统计</view>
            </block>

            <!-- 已答或已上线：结果态 -->
            <block wx:else>
              <view
                wx:for="{{mineDetail.options}}"
                wx:key="id"
                class="qa-detail-option {{item.id === mineDetail.myOptionId ? 'mine' : ''}}"
              >
                <view class="qa-detail-opt-row">
                  <text class="opt-icon">{{item.icon}}</text>
                  <text class="opt-text">{{item.content}}</text>
                  <text wx:if="{{item.id === mineDetail.myOptionId}}" class="mine-tag">✓ 你</text>
                  <text class="opt-percent">{{item.percentText}}</text>
                </view>
                <view class="bar-bg"><view class="bar" style="width: {{item.percent}}%;"></view></view>
              </view>
              <view wx:if="{{mineDetail.status === 0}}" class="submit-tip">已作答，不能修改</view>
            </block>

            <button class="retry-btn ghost mine-back" bindtap="onMineBack">返回列表</button>
          </view>
        </scroll-view>
      </block>
    </view>
  </view>
</view>
