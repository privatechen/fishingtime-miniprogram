.rank-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
}
.rank-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 24rpx 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  /* 固定高度：让 flex 布局有确定空间分配，避免列表被 height:0 压塌（真机不显示） */
  height: 78vh;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.rank-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.rank-title {
  font-size: 32rpx;
  font-weight: 700;
}
.rank-close {
  font-size: 30rpx;
  color: #86909c;
  padding: 8rpx;
}

.rank-tabs {
  display: flex;
  margin-bottom: 12rpx;
}
.rank-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #86909c;
  border-bottom: 4rpx solid transparent;
}
.rank-tab.active {
  color: #2d8cf0;
  font-weight: 700;
  border-bottom-color: #2d8cf0;
}

.rank-state {
  text-align: center;
  color: #c9cdd4;
  padding: 60rpx 0;
  font-size: 26rpx;
}
.retry {
  margin-top: 12rpx;
  color: #2d8cf0;
  font-size: 26rpx;
}

.rank-list {
  flex: 1;
  min-height: 0;
}
.rank-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}
.rank-item.me {
  background: #eaf4ff;
  border-radius: 12rpx;
}
.rank-no {
  width: 60rpx;
  text-align: center;
  font-size: 28rpx;
  color: #86909c;
}
.rank-top {
  color: #2d8cf0;
  font-weight: 700;
}
.rank-name {
  flex: 1;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rank-score {
  font-size: 28rpx;
  font-weight: 600;
  color: #1d2129;
}
.rank-item.me .rank-score {
  color: #2d8cf0;
}

.my-rank {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e5e6eb;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
}
.my-label {
  color: #86909c;
}
.my-value {
  color: #2d8cf0;
  font-weight: 700;
}
